.{
    .name = .wopr,
    .version = "0.0.0",
    .fingerprint = 0x513a2c2452fb3de, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Lazy, so that a build for anything but Linux does not fetch it.
        // PipeWire is a Linux daemon and the library speaks to it with Linux
        // syscalls; `src/play_unsupported.zig` stands in elsewhere.
        .pipewire = .{
            .url = "git+https://git.jcollie.dev/jeff/zig-pipewire.git?ref=main#9f660901bea24bf19cec66b14610405886954305",
            .hash = "pipewire-0.1.0-lH35HuFFBgA9DkhfEJ2jerWTf6-XpUfGG4rxqixgynuC",
            .lazy = true,
        },
        .wav = .{
            .url = "git+https://git.jcollie.dev/jeff/zig-wav.git#47978b799384f27e469358e7ae3776f4b9882978",
            .hash = "wav-0.0.0-w1RoIDwtAgCLuAJCuYfOA3DCEUdts5QwG4BgnuDJUBqi",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "site",
        "src",
        "tests",
        "tools",
        "LICENSES",
        "REUSE.toml",
        "README.md",
    },
}
